# =============================================================================
# HAVOC — example configuration
# Copy to ".env" and fill in your own values. NEVER commit ".env".
# =============================================================================

# --- Telegram API credentials (REQUIRED) -------------------------------------
# Get these from https://my.telegram.org  ->  API development tools
# They are tied to your account; treat API_HASH like a password.
API_ID=
API_HASH=

# Phone number in international format, used only for the first interactive login.
# Optional if you authenticate with a pre-existing session string.
PHONE=

# --- Session storage ---------------------------------------------------------
# Path of the Telethon session file. Keep it OUTSIDE git (default is ignored).
SESSION_PATH=data/havoc

# Headless / server login: paste an existing Telethon StringSession here.
# When set, SESSION_PATH is ignored. Leave empty for normal file sessions.
SESSION_STRING=

# --- Storage -----------------------------------------------------------------
DATABASE_PATH=data/havoc.db
LOG_DIR=logs
BACKUP_DIR=backups
BACKUP_RETENTION=10
DATA_DIR=data

# --- Behaviour ---------------------------------------------------------------
# Command prefix used for every command (single character or short string).
COMMAND_PREFIX=.
# Default UI language: en or fa
DEFAULT_LANGUAGE=en
# IANA timezone used for scheduling and display, e.g. Europe/Berlin, Asia/Tehran
TIMEZONE=Asia/Tehran

# Only these Telegram user IDs may run commands (comma separated). The default
# is the owner's numeric id, because resolving his handle over the network failed
# once and the symptom was "this command is restricted to the account owner".
OWNER_IDS=7542695649
# Owner by handle, the way a person names themselves. Resolved to an id once at
# login and remembered, so nothing waits on the network later. With neither this
# nor OWNER_IDS set, the logged-in account is the owner.
OWNER_USERNAMES=edited_by_nyx

# Chats where automation is allowed. Empty = all chats where the bot is a
# participant. Denylist always wins over the allowlist.
AUTOMATION_ALLOWLIST=
AUTOMATION_DENYLIST=

# --- Safety switches ---------------------------------------------------------
# Preview state-changing actions instead of performing them.
DRY_RUN=false
# Extra verbose diagnostics (still redacts secrets).
DEBUG=false
LOG_LEVEL=INFO

# What to do when the app starts and scheduled jobs are already overdue:
# run_once | skip | ask
MISSED_JOB_POLICY=run_once
# Hard cap on outbound messages per minute (anti-flood self-protection).
OUTBOUND_RATE_LIMIT=20

# --- Optional integrations (never required) ---------------------------------
# AI provider: none | openai_compatible
AI_PROVIDER=none
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT=30
# Several keys, several providers, rotated automatically. The file is read before
# the single AI_API_KEY above; each key may be base64 (`key_b64`) so a public
# repository's push protection accepts the commit. See docs/CONFIGURATION.md.
AI_KEYS_FILE=.auth/ai-keys.json

# Translation provider: ai | mymemory | libretranslate | none
# "ai" (the default behaviour) translates with the model she already talks to —
# Gemma 4 31B on the free Google keys — so .translate needs no extra service.
TRANSLATE_PROVIDER=ai
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=
TRANSLATE_TIMEOUT=15

# --- Plugins -----------------------------------------------------------------
PLUGIN_DIR=plugins
PLUGINS_ENABLED=true

# --- Connection proxy (Telegram only) ---
# Telegram's MTProto is blocked on some networks (Iran among them). Set these to
# route the *Telegram connection* through a proxy; the AI and translation HTTP
# clients are not affected.
# PROXY_TYPE: socks5 | socks4 | http | mtproxy   (empty = direct)
PROXY_TYPE=
PROXY_HOST=
PROXY_PORT=
# Optional for SOCKS5/HTTP:
PROXY_USERNAME=
PROXY_PASSWORD=
# Required for PROXY_TYPE=mtproxy — the secret shown when the proxy was created:
PROXY_SECRET=
